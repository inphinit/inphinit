<IfModule mod_expires.c>
    <FilesMatch "\.(?i:avif|ico|gif|jpe?g|a?png|css|js|svg|webm|oga|ogg|mpe?g|mp4|mpv|mkv)$">
        ExpiresActive On
        ExpiresDefault "access plus 1 mouth"
        FileETag None
    </FilesMatch>
</IfModule>

# Redirect SAPI to errors.php
ErrorDocument 403 /public/index.php
ErrorDocument 500 /public/index.php

RewriteEngine On

# Handle Authorization Header
# RewriteCond %{HTTP:Authorization} .
# RewriteRule . - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Ignore hidden files
RewriteRule ^\.|/\. index.php [L]

# Redirect all urls to index.php if no exits files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
