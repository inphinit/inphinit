{
    "name": "inphinit/inphinit",
    "description": "A framework for easy creation of routes",
    "keywords": [
        "apache", "api", "api", "caddy", "caddy2", "caddyfile", "caddyserver",
        "composer", "css", "dom", "framework", "franken", "frankenphp", "http",
        "iis", "iis", "inphinit", "nginx", "php", "php5", "php7", "php8",
        "rest", "router", "routing", "routing", "url"
    ],
    "license": "MIT",
    "type": "project",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "system/vendor"
    },
    "authors": [
        {
            "name": "Guilherme Nascimento",
            "email": "brcontainer@yahoo.com.br"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "inphinit/framework": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Commands\\": "system/Commands",
            "Controllers\\": "system/Controllers",
            "Models\\": "system/Models"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.sample', '.env');\""
        ],
        "post-update-cmd": [
            "php run pkg:up"
        ]
    }
}
